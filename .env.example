# Intérprete que PySpark debe usar. En Windows no siempre existe python3.
PYSPARK_PYTHON=python
PYSPARK_DRIVER_PYTHON=python

# Sesión local. Para un clúster académico, reemplazar por la URL del maestro.
SPARK_MASTER=local[*]

# Bróker local del docker-compose. No son credenciales.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=siniestros_viales
